@@ -830,6 +830,27 @@ void ChatBackground::setPrepared(
 	Expects(prepared.isNull() || GoodImageFormatAndSize(prepared));
 	Expects(gradient.isNull() || GoodImageFormatAndSize(gradient));
 
+#ifdef CONTRAIL_GTK
+	// The GTK interface draws its own chat background: the core keeps tiny
+	// copies of the default one (its pattern fills a screen, 17 MB), which
+	// is never written to disk or uploaded. Chosen wallpapers stay as they are.
+	if (Data::IsDefaultWallPaper(_paper)) {
+		const auto shrink = [](QImage &image) {
+			constexpr auto kMax = 64;
+			if (image.width() > kMax || image.height() > kMax) {
+				image = image.scaled(
+					kMax,
+					kMax,
+					Qt::KeepAspectRatio,
+					Qt::FastTransformation);
+			}
+		};
+		shrink(original);
+		shrink(prepared);
+		shrink(gradient);
+	}
+#endif // CONTRAIL_GTK
+
 	if (!prepared.isNull() && !_paper.isPattern() && _paper.isBlurred()) {
 		prepared = Ui::PrepareBlurredBackground(std::move(prepared));
 	}
