#!/bin/sh
# Contrail launcher.
APPDIR="$(dirname "$(readlink -f "$0")")"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

export LD_LIBRARY_PATH="$APPDIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Telegram Desktop's core runs Qt, but its window is never shown: the interface is GTK.
export QT_QPA_PLATFORM=offscreen
export QT_PLUGIN_PATH="$APPDIR/plugins"
export CONTRAIL_DIR="$APPDIR"
# The core's application ID (D-Bus name, notifications) is Contrail's, not Telegram Desktop's.
export CONTRAIL_APP_ID=io.github.x_vlad_x.Contrail

if [ "$1" = "--check-libs" ]; then
  ! ldd -r "$APPDIR/bin/contrail" 2>&1 | grep -E "not found|undefined symbol"
  exit $?
fi

# Separate from the official Telegram Desktop (~/.local/share/TelegramDesktop).
mkdir -p "$DATA_HOME/contrail-data/tdata"
# The core would register itself as the tg:// handler bypassing this launcher; the desktop entry does it.
OPTIONS="$DATA_HOME/contrail-data/tdata/experimental_options.json"
[ -f "$OPTIONS" ] || echo '{"skip-url-scheme-register": true}' > "$OPTIONS"
exec "$APPDIR/bin/contrail" -workdir "$DATA_HOME/contrail-data/" "$@"
