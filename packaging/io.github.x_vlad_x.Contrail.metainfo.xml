<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.x_vlad_x.Contrail</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-GPL-3.0-with-OpenSSL-exception</project_license>
  <name>Contrail</name>
  <summary>Unofficial Telegram client for Linux phones</summary>
  <description>
    <p>
      Contrail is an unofficial client that uses the Telegram API. It is built on the Telegram Desktop core
      and replaces its interface with an adaptive GTK4 and libadwaita one: a single column on a phone, the chat
      list and the chat side by side on a wider screen.
    </p>
    <p>
      Contrail is not affiliated with or endorsed by Telegram. It is a preview: group calls, stories,
      reactions, folders and multiple accounts are not available yet.
    </p>
  </description>
  <developer id="io.github.x_vlad_x">
    <name>Vladislav Shadiuk</name>
  </developer>
  <launchable type="desktop-id">io.github.x_vlad_x.Contrail.desktop</launchable>
  <url type="homepage">https://github.com/x-vlad-x/contrail</url>
  <url type="bugtracker">https://github.com/x-vlad-x/contrail/issues</url>
  <url type="vcs-browser">https://github.com/x-vlad-x/contrail</url>
  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
  </categories>
  <keywords>
    <keyword>Telegram</keyword>
    <keyword>chat</keyword>
    <keyword>messenger</keyword>
  </keywords>
  <provides>
    <binary>contrail</binary>
  </provides>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <screenshots>
