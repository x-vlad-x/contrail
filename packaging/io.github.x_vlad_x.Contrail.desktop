[Desktop Entry]
Type=Application
Version=1.5
Name=Contrail
GenericName=Unofficial Telegram Client
GenericName[ru]=Неофициальный клиент Telegram
Comment=Chat on Telegram: an unofficial client that uses the Telegram API
Comment[ru]=Переписка в Telegram: неофициальный клиент, использующий Telegram API
Icon=io.github.x_vlad_x.Contrail
Exec=contrail -- %u
Terminal=false
StartupNotify=true
StartupWMClass=io.github.x_vlad_x.Contrail
Categories=Network;InstantMessaging;Chat;GTK;
Keywords=Telegram;tg;chat;im;messaging;messenger;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
X-Purism-FormFactor=Workstation;Mobile;
# Phosh: the incoming call notification's Accept and Decline (and End Call) work on the lock screen.
X-Phosh-Lockscreen-Actions=call-;
