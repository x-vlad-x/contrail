# FuriOS 14 is a snapshot of Debian testing (forky) served from FuriOS's own mirror. Building against the very
# same packages makes the program use the phone's own libraries (glibc, Qt, FFmpeg...).
# Cross-compiles for arm64 via multiarch; code generators that Telegram Desktop builds and runs during the
# build are run with qemu-user.
FROM docker.io/library/debian:testing-20260610
# The base image has no CA certificates yet: the first download skips the TLS check (apt still verifies the
# packages with Debian's signatures), then the mirror's ca-certificates are installed and the check is back.
RUN printf 'Types: deb\nURIs: https://debian.furios.io/\nSuites: forky forky-updates\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
      > /etc/apt/sources.list.d/debian.sources \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99furios-snapshot \
    && apt-get -o Acquire::https::Verify-Peer=false update \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::https::Verify-Peer=false install -y --allow-downgrades ca-certificates \
    && apt-get update
RUN dpkg --add-architecture arm64 && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      crossbuild-essential-arm64 build-essential cmake ninja-build pkgconf python3 git ca-certificates file curl \
      qemu-user protobuf-compiler libwayland-bin gobject-introspection qt6-base-dev-tools patchelf xz-utils \
      autoconf automake libtool \
    && rm -rf /var/lib/apt/lists/*
# Telegram Desktop (the same list as the Debian package, for arm64; rnnoise is built by build-deps.sh).
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      qt6-base-dev:arm64 qt6-base-private-dev:arm64 qt6-svg-dev:arm64 qt6-wayland-dev:arm64 \
      libavcodec-dev:arm64 libavfilter-dev:arm64 libavformat-dev:arm64 libavutil-dev:arm64 \
      libswresample-dev:arm64 libswscale-dev:arm64 libboost-regex-dev:arm64 libexpected-dev \
      libglib2.0-dev:arm64 libglibmm-2.68-dev:arm64 gir1.2-glib-2.0-dev:arm64 libhunspell-dev:arm64 \
      libjpeg-dev:arm64 libkf6coreaddons-dev:arm64 liblz4-dev:arm64 libminizip-dev:arm64 libmsgsl-dev \
      libopenal-dev:arm64 libopus-dev:arm64 libpulse-dev:arm64 libasound2-dev:arm64 libqrcodegencpp-dev:arm64 \
      librange-v3-dev libssl-dev:arm64 libxcb1-dev:arm64 libxcb-keysyms1-dev:arm64 \
      libxcb-record0-dev:arm64 libxcb-screensaver0-dev:arm64 libxxhash-dev:arm64 xdg-desktop-portal-dev \
      zlib1g-dev:arm64 libada-url-dev:arm64 libvpx-dev:arm64 libopenh264-dev:arm64 \
      libfido2-dev:arm64 libudev-dev:arm64 libprotobuf-dev:arm64 libpango1.0-dev:arm64 libxkbcommon-dev:arm64 \
      libpipewire-0.3-dev:arm64 libx11-dev:arm64 libxext-dev:arm64 libxfixes-dev:arm64 libxtst-dev:arm64 \
      libxrandr-dev:arm64 libxrender-dev:arm64 libxdamage-dev:arm64 libxcomposite-dev:arm64 \
      libdrm-dev:arm64 libgbm-dev:arm64 libegl-dev:arm64 libgl-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*
# The GTK interface.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libgtk-4-dev:arm64 libadwaita-1-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*
# Rust, for the Rust part of Telegram Desktop (tlottie, wallet engine): the toolchain the official build pins.
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal --default-toolchain 1.96.1 \
      --target aarch64-unknown-linux-gnu && chmod -R a+rwX /opt/rustup /opt/cargo
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc QEMU_LD_PREFIX=/ \
    PKG_CONFIG_PATH=/src/deps-aarch64/prefix/lib/pkgconfig \
    GI_GIR_PATH=/usr/lib/aarch64-linux-gnu/gir-1.0:/usr/share/gir-1.0
# TDLib (tde2e) generates sources with gperf; Telegram Desktop compiles its shaders with qsb and its emoji
# are WebP images (the Qt plugin is bundled, FuriOS doesn't install it).
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gperf qt6-shader-baker qt6-image-formats-plugins:arm64 \
    && rm -rf /var/lib/apt/lists/*
# Packaging: application icons at standard sizes, desktop entry and metainfo checks.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      librsvg2-bin desktop-file-utils appstream \
    && rm -rf /var/lib/apt/lists/*
# Showing an incoming call over the phone's lock screen (layer shell).
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libgtk4-layer-shell-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*
